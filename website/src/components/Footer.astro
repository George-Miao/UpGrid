---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
---

<footer class="documentation-footer">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  <section class="project-information" aria-label="Project information">
    <nav class="footer-links" aria-label="Project links">
      <a href="https://miao.dev">A project by Pop</a>
      <span class="separator" aria-hidden="true">|</span>
      <a href="https://github.com/George-Miao/UpGrid">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <g
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5c.08-1.25-.27-2.48-1-3.5c.28-1.15.28-2.35 0-3.5c0 0-1 0-3 1.5c-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5c-.39.49-.68 1.05-.85 1.65c-.17.6-.22 1.23-.15 1.85v4"
            />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </g>
        </svg>
        GitHub
      </a>
      <span class="separator" aria-hidden="true">|</span>
      <a href="https://upgrid.rs">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <g
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          >
            <path
              d="M15 21v-4a2 2 0 0 1 2-2h4M7 4v2a3 3 0 0 0 3 2h0a2 2 0 0 1 2 2a2 2 0 0 0 4 0a2 2 0 0 1 2-2h3M3 11h2a2 2 0 0 1 2 2v1a2 2 0 0 0 2 2a2 2 0 0 1 2 2v4"
            />
            <circle cx="12" cy="12" r="10" />
          </g>
        </svg>
        upgrid.rs
      </a>
    </nav>
    <p class="footer-powered">
      Proudly powered by <a href="https://compio.rs/">Compio</a> and{' '}
      <a href="https://github.com/databendlabs/openraft">OpenRaft</a>
    </p>
  </section>
</footer>

<style>
  @layer starlight.core {
    .documentation-footer {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .meta {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem 3rem;
      margin-top: 3rem;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    .project-information {
      display: flex;
      width: 100%;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.5rem;
      border-top: 1px solid var(--ug-line);
      padding: 1.25rem 0 1.5rem;
      color: var(--ug-muted);
      font-size: 0.75rem;
    }

    .footer-links,
    .footer-powered {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.625rem;
      margin: 0;
      text-align: center;
    }

    .project-information a {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      border-radius: 4px;
      color: var(--ug-muted);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      transition: color 160ms ease;
      cursor: pointer;
      user-select: none;
    }

    .project-information a:hover,
    .project-information a:focus-visible {
      color: var(--ug-text);
    }

    .project-information a:focus-visible {
      outline: 2px solid var(--ug-focus);
      outline-offset: 2px;
    }

    .project-information :global(svg) {
      width: 0.875rem;
      height: 0.875rem;
      flex: none;
      font-size: 0.875rem;
    }

    @media (max-width: 30rem) {
      .separator {
        display: none;
      }
    }
  }
</style>
