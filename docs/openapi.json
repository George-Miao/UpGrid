  "components": {
    "schemas": {
      "AlertView": {
        "type": "object",
        "required": [
          "target_id",
          "channel_id",
          "kind",
          "target_name",
          "scheduled_at_ms",
          "delivery"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "format": "uuid"
          },
          "delivery": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "scheduled_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "target_id": {
            "type": "string",
            "format": "uuid"
          },
          "target_name": {
            "type": "string"
          }
        }
      },
      "ChannelView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "destination"
        ],
        "properties": {
          "destination": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ConfigValueInput": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "secret_id"
            ],
            "properties": {
              "secret_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      },
      "ConfigValueView": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "literal"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "secret_id",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "secret"
                ]
              },
              "secret_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      },
      "CreateJoinTokenRequest": {
        "type": "object",
        "properties": {
          "expires_in_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "EvaluationView": {
        "type": "object",
        "required": [
          "scheduled_at_ms",
          "recorded_at_ms",
          "executor_node_id",
          "succeeded",
          "latency_ms"
        ],
        "properties": {
          "diagnostic": {
            "type": [
              "string",
              "null"
            ]
          },
          "executor_node_id": {
            "type": "string",
            "format": "uuid"
          },
          "latency_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "recorded_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "scheduled_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "succeeded": {
            "type": "boolean"
          }
        }
      },
      "JoinTokenView": {
        "type": "object",
        "required": [
          "token",
          "expires_at_ms"
        ],
        "properties": {
          "expires_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "token": {
            "type": "string"
          }
        }
      },
      "PutChannelRequest": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "name",
              "bot_token",
              "chat_id",
              "type"
            ],
            "properties": {
              "bot_token": {
                "type": "string"
              },
              "chat_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "telegram"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "name",
              "url",
              "type"
            ],
            "properties": {
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/ConfigValueInput"
                },
                "propertyNames": {
                  "type": "string"
                }
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "webhook"
                ]
              },
              "url": {
                "type": "string"
              }
            }
          }
        ]
      },
      "PutSecretRequest": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "PutTargetRequest": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "accepted_statuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusRangeInput"
            }
          },
          "body": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConfigValueInput"
              }
            ]
          },
          "body_contains": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_threshold": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "follow_redirects": {
            "type": "boolean"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ConfigValueInput"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "interval_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_redirects": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "method": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "notification_channel_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "skip_tls_verification": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        }
      },
      "SecretView": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "StatusRangeInput": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "start": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "TargetView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "method",
          "headers",
          "accepted_statuses",
          "follow_redirects",
          "max_redirects",
          "skip_tls_verification",
          "interval_seconds",
          "timeout_seconds",
          "failure_threshold",
          "notification_channel_ids",
          "availability",
          "consecutive_failures",
          "history"
        ],
        "properties": {
          "accepted_statuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusRangeInput"
            }
          },
          "availability": {
            "type": "string"
          },
          "body": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConfigValueView"
              }
            ]
          },
          "body_contains": {
            "type": [
              "string",
              "null"
            ]
          },
          "consecutive_failures": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "failure_threshold": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "follow_redirects": {
            "type": "boolean"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ConfigValueView"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationView"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "interval_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "latest_evaluation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EvaluationView"
              }
            ]
          },
          "max_redirects": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "method": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "notification_channel_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "skip_tls_verification": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
